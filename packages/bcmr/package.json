{
  "type": "module",
  "name": "@mainnet-cash/bcmr",
  "version": "4.0.0-next.13",
  "module": "dist/module/index.js",
  "types": "dist/module/index.d.ts",
  "exports": {
    "types": "./dist/module/index.d.ts",
    "import": "./dist/module/index.js"
  },
  "files": [
    "dist/module"
  ],
  "license": "MIT",
  "author": "readcash",
  "dependencies": {
    "mainnet-js": "4.0.0-next.13"
  },
  "devDependencies": {},
  "scripts": {
    "build": "yarn build:module && yarn build:browser",
    "build:module": "tsc -p tsconfig.build.json",
    "build:browser": "vite build && BUILD_TARGET=test vite build",
    "build:production": "yarn build:module && NODE_ENV=production yarn build:browser",
    "test": "vitest run --config ../../test/vitest.config.ts",
    "test:mock": "USE_MOCK_PROVIDER=1 vitest run --config ../../test/vitest.config.ts",
    "publish:public": "yarn publish --access public"
  }
}
