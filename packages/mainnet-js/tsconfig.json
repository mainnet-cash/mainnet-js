{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "downlevelIteration": true,
    "composite": true,
    "target": "esnext",
    "module": "esnext",
    "outDir": "./dist/module",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "typeRoots": [
      "node_modules/@types",
      "../../node_modules/@types",
      "./src/types"
    ],
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "strictPropertyInitialization": false,
    "useDefineForClassFields": false,
    "paths": {
      "#test/*": ["../../test/*"],
      "@rpckit/core/electrum-cash": [
        "../../node_modules/@rpckit/core/dist/electrum-cash/index.d.ts"
      ],
      "@rpckit/websocket/electrum-cash": [
        "../../node_modules/@rpckit/websocket/dist/electrum-cash/index.d.ts"
      ],
      "@rpckit/fallback/electrum-cash": [
        "../../node_modules/@rpckit/fallback/dist/electrum-cash/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "../../test/vitest-globals.d.ts"],
  "exclude": ["node_modules/**"],
  "compileOnSave": false
}
