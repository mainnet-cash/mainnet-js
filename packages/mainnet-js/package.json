{
  "type": "module",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/mainnet-cash/mainnet-js/"
  },
  "bugs": {
    "url": "https://github.com/mainnet-cash/mainnet-js/issues"
  },
  "name": "mainnet-js",
  "version": "4.0.0-next.11",
  "homepage": "https://mainnet.cash",
  "module": "dist/module/index.js",
  "types": "dist/module/index.d.ts",
  "exports": {
    "types": "./dist/module/index.d.ts",
    "import": "./dist/module/index.js"
  },
  "files": [
    "dist/module"
  ],
  "scripts": {
    "clean": "rm -fr dist/*",
    "cli": "npx tsx src/cli.ts",
    "build": "yarn clean && yarn build:module && yarn build:browser",
    "build:module": "tsc -p tsconfig.build.json",
    "build:browser": "vite build && BUILD_TARGET=test vite build",
    "build:production": "yarn clean && yarn build:module && NODE_ENV=production yarn build:browser",
    "demo": "npx reload --dir=demo/",
    "publish:public": "yarn publish --access public",
    "test": "node --max-old-space-size=8000 --expose-gc ../../node_modules/vitest/vitest.mjs run --config ../../test/vitest.config.ts",
    "test:browser": "npx vitest run --config ../../test/vitest.config.browser.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@rpckit/core": "^2.2.0",
    "@rpckit/fallback": "^2.2.0",
    "@rpckit/websocket": "^2.2.0"
  },
  "sideEffects": false,
  "keywords": [
    "bch",
    "bitcoin cash",
    "wasm"
  ],
  "author": "readcash",
  "devDependencies": {
    "@mem-cash/electrum": "^0.0.2",
    "@mem-cash/validation": "^0.0.2",
    "dotenv": "^10.0.0"
  }
}
