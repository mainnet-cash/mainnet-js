{
  "license": "MIT",
  "repository": {
    "url": "https://github.com/mainnet-cash/mainnet-js/"
  },
  "bugs": {
    "url": "https://github.com/mainnet-cash/mainnet-js/issues"
  },
  "name": "@mainnet-cash/root",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [
      "**/demo/**"
    ]
  },
  "version": "4.0.0-next.10",
  "homepage": "https://mainnet.cash",
  "scripts": {
    "api:validate": "docker run --rm -v ${PWD}:/local openapitools/openapi-generator-cli:v6.2.1 validate -i /local/swagger/v1/api.yml",
    "api:build:server": "docker run --rm -v ${PWD}:/local openapitools/openapi-generator-cli:v6.2.1 generate -i /local/swagger/v1/api.yml -g nodejs-express-server -o /local/packages/mainnet-cash",
    "api:build:client": "node swagger/generate.js",
    "api:serve:install": "yarn install --production=true --cwd packages/mainnet-cash/ --prefix packages/mainnet-cash/",
    "api:serve:test": "yarn workspace mainnet-cash run test",
    "api:serve:cluster": "yarn workspace mainnet-cash run start",
    "api:serve": "node --trace-warnings packages/mainnet-cash/serve.js",
    "bump": "node bump_version.cjs",
    "cli": "yarn workspace mainnet-js run cli",
    "coverage": "rm -rf coverage/ && COVERAGE=true yarn test",
    "coverage:mock": "rm -rf coverage/ && COVERAGE=true yarn test:mock",
    "docs": "npx typedoc",
    "test": "node --max-old-space-size=8000 --expose-gc node_modules/vitest/vitest.mjs run --config test/vitest.config.ts",
    "test:skip": "SKIP_REGTEST_INIT=1 yarn test",
    "test:mock": "USE_MOCK_PROVIDER=1 node --max-old-space-size=8000 --expose-gc node_modules/vitest/vitest.mjs run --config test/vitest.config.ts",
    "test:rest": "yarn workspace mainnet-cash run test",
    "test:rest:skip": "SKIP_REGTEST_INIT=1 yarn test:rest",
    "test:browser": "npx playwright install chromium && npx vitest run --config test/vitest.config.browser.ts",
    "test:browser:skip": "SKIP_REGTEST_INIT=1 yarn test:browser",
    "regtest:up": "./test/docker/start.sh",
    "regtest:down": "./test/docker/stop.sh",
    "regtest:sbch:up": "./test/docker/start-sbch-lite.sh",
    "regtest:sbch:down": "./test/docker/stop-sbch-lite.sh",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write --unsafe .",
    "nuke": "rm -fr node_modules && yarn remove:packages",
    "remove:packages": "rm -fr packages/*/node_modules && rm -fr packages/*/dist",
    "build": "yarn build:mainnet-js && yarn build:indexeddb-storage && yarn build:postgresql-storage && yarn build:bcmr",
    "build:mainnet-js": "yarn workspace mainnet-js run build",
    "build:indexeddb-storage": "yarn workspace @mainnet-cash/indexeddb-storage run build",
    "build:postgresql-storage": "yarn workspace @mainnet-cash/postgresql-storage run build",
    "build:bcmr": "yarn workspace @mainnet-cash/bcmr run build",
    "build:production": "yarn workspace mainnet-js run build:production && yarn workspace @mainnet-cash/indexeddb-storage run build:production && yarn workspace @mainnet-cash/postgresql-storage run build:production && yarn workspace @mainnet-cash/bcmr run build:production",
    "link:mainnet-js": "yarn workspace mainnet-js link && yarn workspace @mainnet-cash/indexeddb-storage link mainnet-js && yarn workspace @mainnet-cash/postgresql-storage link mainnet-js && yarn workspace @mainnet-cash/bcmr link mainnet-js && yarn workspace mainnet-cash link mainnet-js",
    "link:postgresql-storage": "yarn workspace @mainnet-cash/postgresql-storage link && yarn workspace mainnet-cash link @mainnet-cash/postgresql-storage",
    "link:all": "yarn link:mainnet-js && yarn link:postgresql-storage",
    "postinstall": "yarn link:all"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^22.0.0",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^10.0.0",
    "node-localstorage": "^3.0.5",
    "playwright": "^1.49.1",
    "semver": "^7.5.4",
    "supertest": "^6.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.6.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "winston": "3.3.3",
    "yaml": "^2.4.2"
  },
  "optionalDependencies": {},
  "keywords": [
    "bch",
    "bitcoin cash"
  ],
  "author": "readcash",
  "dependencies": {}
}
